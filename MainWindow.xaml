<Window x:Class="CalculatorWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CalculatorWpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="225" Width="300">
    <Window.Resources>
        <Style x:Key="BaseButton" TargetType="Button">
         <Setter Property = "FontSize" Value = "20" />
         <Setter Property = "Background" Value = "Honeydew" />
        </Style>
    </Window.Resources>
    <Grid x:Name="grid">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Label 
            x:Name="displayLabel" 
            Content="" 
            Grid.Row="0"
            Grid.ColumnSpan="4"
        />
        <Button 
            x:Name="sevenButton"
            Style="{StaticResource BaseButton}"
            Content="7" 
            Grid.Row="1" 
            Grid.Column="0"
        />
        <Button 
            x:Name="eightButton"
            Style="{StaticResource BaseButton}"
            Content="8" 
            Grid.Row="1" 
            Grid.Column="1"
        />
        <Button 
            x:Name="nineButton"
            Style="{StaticResource BaseButton}"
            Content="9" 
            Grid.Row="1" 
            Grid.Column="2"
        />
        <Button 
            x:Name="plusButton"
            Style="{StaticResource BaseButton}"
            Content="+" 
            Grid.Row="1" 
            Grid.Column="3"
        />
        <Button 
            x:Name="sixButton"
            Style="{StaticResource BaseButton}"
            Content="6" 
            Grid.Row="2" 
            Grid.Column="0"
        />
        <Button 
            x:Name="fiveButton"
            Style="{StaticResource BaseButton}"
            Content="5" 
            Grid.Row="2" 
            Grid.Column="1"
        />
        <Button 
            x:Name="fourButton"
            Style="{StaticResource BaseButton}"
            Content="4" 
            Grid.Row="2" 
            Grid.Column="2"
        />
        <Button 
            x:Name="minusButton"
            Style="{StaticResource BaseButton}"
            Content="-" 
            Grid.Row="2" 
            Grid.Column="3"
        />
        <Button 
            x:Name="threeButton"
            Style="{StaticResource BaseButton}"
            Content="3" 
            Grid.Row="3" 
            Grid.Column="0"
        />
        <Button 
            x:Name="twoButton"
            Style="{StaticResource BaseButton}"
            Content="2" 
            Grid.Row="3" 
            Grid.Column="1"
        />
        <Button 
            x:Name="oneButton"
            Style="{StaticResource BaseButton}"
            Content="1" 
            Grid.Row="3" 
            Grid.Column="2"
        />
        <Button 
            x:Name="multiplyButton"
            Style="{StaticResource BaseButton}"
            Content="*" 
            Grid.Row="3" 
            Grid.Column="3"
        />
        <Button 
            x:Name="clearButton"
            Style="{StaticResource BaseButton}"
            Content="C" 
            Grid.Row="4" 
            Grid.Column="0"
        />
        <Button 
            x:Name="zeroButton"
            Style="{StaticResource BaseButton}"
            Content="0" 
            Grid.Row="4" 
            Grid.Column="1"
        />
        <Button 
            x:Name="resultButton"
            Style="{StaticResource BaseButton}"
            Content="=" 
            Grid.Row="4" 
            Grid.Column="2"
        />
        <Button 
            x:Name="devideButton"
            Style="{StaticResource BaseButton}"
            Content="/" 
            Grid.Row="4" 
            Grid.Column="3"
        />
        

    </Grid>
</Window>
